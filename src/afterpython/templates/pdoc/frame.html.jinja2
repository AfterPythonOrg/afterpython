{% extends "default/frame.html.jinja2" %}
{% block head %}
    {# Same as the project website's app.html: follow the theme chosen on the website
       (same origin, so its localStorage is shared), else the OS setting.
       Dark colors are in theme.css, syntax-highlighting.css and custom.css. #}
    <script>
        (function () {
            const query = window.matchMedia('(prefers-color-scheme: dark)');
            const apply = (dark) => document.documentElement.classList.toggle('dark', dark);
            const stored = localStorage.getItem('theme');
            apply(stored ? stored === 'dark' : query.matches);
            query.addEventListener('change', (e) => {
                if (!localStorage.getItem('theme')) apply(e.matches);
            });
        })();
    </script>
    {# Override pdoc's default 35vh logo height — too dominant in the sidebar.
       The dark logo (see module.html.jinja2) replaces the light one in dark mode. #}
    <style>
        nav.pdoc img.logo { max-height: 3rem; margin-bottom: 1.5rem; }
        nav.pdoc img.logo-dark, html.dark nav.pdoc img.logo-light { display: none; }
        html.dark nav.pdoc img.logo-dark { display: block; }
    </style>
{% endblock %}
